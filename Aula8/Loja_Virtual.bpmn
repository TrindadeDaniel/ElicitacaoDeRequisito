<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Cliente" name="Cliente" processRef="Process_Cliente" />
    <bpmn:participant id="Participant_Loja" name="Loja Virtual" processRef="Process_Loja" />
    <bpmn:messageFlow id="Msg_Pedido" name="Pedido" sourceRef="Task_RealizarPedido" targetRef="Task_Registrar" />
    <bpmn:messageFlow id="Msg_Rastreio" name="Código de rastreio" sourceRef="Task_Rastreio" targetRef="Task_ReceberRastreio" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Cliente" isExecutable="false">
    <bpmn:startEvent id="Start_Cliente" name="Precisa comprar">
      <bpmn:outgoing>C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_RealizarPedido" name="Realizar pedido">
      <bpmn:incoming>C1</bpmn:incoming>
      <bpmn:outgoing>C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Aguardar" name="Aguardar processamento">
      <bpmn:incoming>C2</bpmn:incoming>
      <bpmn:outgoing>C3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReceberRastreio" name="Receber código de rastreio">
      <bpmn:incoming>C3</bpmn:incoming>
      <bpmn:outgoing>C4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Cliente" name="Compra concluída">
      <bpmn:incoming>C4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="C1" sourceRef="Start_Cliente" targetRef="Task_RealizarPedido" />
    <bpmn:sequenceFlow id="C2" sourceRef="Task_RealizarPedido" targetRef="Task_Aguardar" />
    <bpmn:sequenceFlow id="C3" sourceRef="Task_Aguardar" targetRef="Task_ReceberRastreio" />
    <bpmn:sequenceFlow id="C4" sourceRef="Task_ReceberRastreio" targetRef="End_Cliente" />
  </bpmn:process>

  <bpmn:process id="Process_Loja" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Atendimento" name="Atendimento">
        <bpmn:flowNodeRef>Start_Loja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Pagamento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recusa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cancelado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NF</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Estoque" name="Estoque e Expedição">
        <bpmn:flowNodeRef>Task_Separar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Embalar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rastreio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Enviado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Loja" name="Pedido recebido">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Registrar" name="Registrar pedido">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Pagamento" name="Pagamento aprovado?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Recusa" name="Notificar recusa">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Cancelado" name="Pedido cancelado">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_Split">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_NF" name="Emitir nota fiscal">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Separar" name="Separar produtos">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Embalar" name="Embalar e enviar">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Rastreio" name="Enviar código de rastreio">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Enviado" name="Pedido enviado">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Loja" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Registrar" targetRef="Gateway_Pagamento" />
    <bpmn:sequenceFlow id="F3" name="Não" sourceRef="Gateway_Pagamento" targetRef="Task_Recusa" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Recusa" targetRef="End_Cancelado" />
    <bpmn:sequenceFlow id="F5" name="Sim" sourceRef="Gateway_Pagamento" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gateway_Split" targetRef="Task_NF" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gateway_Split" targetRef="Task_Separar" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Separar" targetRef="Task_Embalar" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Embalar" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_NF" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gateway_Join" targetRef="Task_Rastreio" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Rastreio" targetRef="End_Enviado" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="S_PC" bpmnElement="Participant_Cliente" isHorizontal="true"><dc:Bounds x="160" y="40" width="1200" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_PL" bpmnElement="Participant_Loja" isHorizontal="true"><dc:Bounds x="160" y="260" width="1200" height="500" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_LA" bpmnElement="Lane_Atendimento" isHorizontal="true"><dc:Bounds x="190" y="260" width="1170" height="260" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_LE" bpmnElement="Lane_Estoque" isHorizontal="true"><dc:Bounds x="190" y="520" width="1170" height="240" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_StartC" bpmnElement="Start_Cliente"><dc:Bounds x="222" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="195" y="145" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TRP" bpmnElement="Task_RealizarPedido"><dc:Bounds x="300" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TAg" bpmnElement="Task_Aguardar"><dc:Bounds x="680" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TRR" bpmnElement="Task_ReceberRastreio"><dc:Bounds x="1060" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndC" bpmnElement="End_Cliente"><dc:Bounds x="1232" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1205" y="145" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_StartL" bpmnElement="Start_Loja"><dc:Bounds x="222" y="382" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="195" y="425" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TReg" bpmnElement="Task_Registrar"><dc:Bounds x="300" y="360" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GP" bpmnElement="Gateway_Pagamento" isMarkerVisible="true"><dc:Bounds x="455" y="375" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="435" y="432" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TRec" bpmnElement="Task_Recusa"><dc:Bounds x="560" y="270" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndCan" bpmnElement="End_Cancelado"><dc:Bounds x="722" y="292" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="695" y="335" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GS" bpmnElement="Gateway_Split"><dc:Bounds x="575" y="375" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TNF" bpmnElement="Task_NF"><dc:Bounds x="680" y="360" width="100" height="80" /></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_TSep" bpmnElement="Task_Separar"><dc:Bounds x="680" y="600" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TEmb" bpmnElement="Task_Embalar"><dc:Bounds x="840" y="600" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GJ" bpmnElement="Gateway_Join"><dc:Bounds x="965" y="615" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_TRas" bpmnElement="Task_Rastreio"><dc:Bounds x="1060" y="600" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndEnv" bpmnElement="End_Enviado"><dc:Bounds x="1232" y="622" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1205" y="665" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E_C1" bpmnElement="C1"><di:waypoint x="258" y="120" /><di:waypoint x="300" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_C2" bpmnElement="C2"><di:waypoint x="400" y="120" /><di:waypoint x="680" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_C3" bpmnElement="C3"><di:waypoint x="780" y="120" /><di:waypoint x="1060" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_C4" bpmnElement="C4"><di:waypoint x="1160" y="120" /><di:waypoint x="1232" y="120" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_F1" bpmnElement="F1"><di:waypoint x="258" y="400" /><di:waypoint x="300" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2" bpmnElement="F2"><di:waypoint x="400" y="400" /><di:waypoint x="455" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3" bpmnElement="F3"><di:waypoint x="480" y="375" /><di:waypoint x="480" y="310" /><di:waypoint x="560" y="310" /><bpmndi:BPMNLabel><dc:Bounds x="486" y="335" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4" bpmnElement="F4"><di:waypoint x="660" y="310" /><di:waypoint x="722" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F5" bpmnElement="F5"><di:waypoint x="505" y="400" /><di:waypoint x="575" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="520" y="382" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F6" bpmnElement="F6"><di:waypoint x="625" y="400" /><di:waypoint x="680" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F7" bpmnElement="F7"><di:waypoint x="600" y="425" /><di:waypoint x="600" y="640" /><di:waypoint x="680" y="640" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F8" bpmnElement="F8"><di:waypoint x="780" y="640" /><di:waypoint x="840" y="640" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F9" bpmnElement="F9"><di:waypoint x="940" y="640" /><di:waypoint x="965" y="640" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F10" bpmnElement="F10"><di:waypoint x="780" y="400" /><di:waypoint x="990" y="400" /><di:waypoint x="990" y="615" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F11" bpmnElement="F11"><di:waypoint x="1015" y="640" /><di:waypoint x="1060" y="640" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F12" bpmnElement="F12"><di:waypoint x="1160" y="640" /><di:waypoint x="1232" y="640" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="E_M1" bpmnElement="Msg_Pedido"><di:waypoint x="350" y="160" /><di:waypoint x="350" y="360" /><bpmndi:BPMNLabel><dc:Bounds x="357" y="225" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_M2" bpmnElement="Msg_Rastreio"><di:waypoint x="1110" y="600" /><di:waypoint x="1110" y="160" /><bpmndi:BPMNLabel><dc:Bounds x="1117" y="225" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
